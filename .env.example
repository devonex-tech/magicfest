# Setat automat de `vercel integration add neon` (local: `vercel env pull`)
DATABASE_URL=

# Opțional - notificări email către organizator prin Resend
RESEND_API_KEY=

# Opțional - adresa expeditorului pentru notificări (fallback: onboarding@resend.dev)
NOTIFY_FROM=

# Parola paginii de administrare /admin (user: admin)
ADMIN_PASSWORD=

# Brevo - lista de participanți și atributele de stare a plății (PLATA)
BREVO_API_KEY=
BREVO_PARTICIPANTS_LIST_ID=

# Stripe - creează sesiunea de plată și confirmă plățile
STRIPE_SECRET_KEY=

# Stripe - id-ul de preț pentru fiecare pachet de înscriere.
# Opționale: fără ele se folosesc prețurile deja existente în cont
# (119 € pentru Magician și Dealer Assistant, 149 € pentru Competitor).
# STRIPE_PRICE_DEALER (189 €) NU are încă preț în Stripe: până când e completat,
# cine alege pachetul Dealer este trecut automat pe „plătesc mai târziu".
STRIPE_PRICE_MAGICIAN=
STRIPE_PRICE_COMPETITOR=
STRIPE_PRICE_DEALER=
STRIPE_PRICE_DEALER_ASSISTANT=

# Secret pentru sincronizarea în masă a plăților:
#   curl -X POST "https://magicartfest.eu/api/payment-confirm?sync=1" -H "x-sync-secret: ..."
# Fără el, modul de sincronizare e oprit (răspunde 404).
SYNC_SECRET=
